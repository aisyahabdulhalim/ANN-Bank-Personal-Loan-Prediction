    "from sklearn.preprocessing import OrdinalEncoder\n",
    "\n",
    "encoder = OrdinalEncoder()\n",
    "feature_encoded = encoder.fit_transform(dataset[['job', 'marital', 'education', 'housing', 'loan']]) \n",
    "\n",
    "dataset['job_encoded'] = feature_encoded[:, :1] # Assign the encoded 'Gender' column to a new column 'gender_encoded'\n",
    "dataset['marital_encoded'] = feature_encoded[:, 1:2] # Assign the encoded 'Age Category' column to a new column 'AgeCategory_encoded'\n",
    "dataset['education_encoded'] = feature_encoded[:, :1] # Assign the encoded 'Gender' column to a new column 'gender_encoded'\n",
    "dataset['housing_encoded'] = feature_encoded[:, 1:2]\n",
    "dataset['loan_encoded'] = feature_encoded[:, :1]\n",
    "\n",
    "dataset.head()"
   ]
